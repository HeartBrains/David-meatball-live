{
  "name": "david-meatball-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "npm run build && wrangler dev --local --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply david-meatball-live-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply david-meatball-live-db --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  }
}
