{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "david-meatball-live",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "david-meatball-live-db",
      "database_id": "274ae807-e54a-4f92-9a80-f5917daa06d7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "MCP_ENABLED": "false",
    "CF_ACCESS_ISSUER": "https://applicationcms.cloudflareaccess.com",
    "CF_ACCESS_AUD": "d1f59c7c706765a1584685cdd65946ccd1f695e6ea04056ebe72498af4f9e6a8"
  },
  "observability": {
    "enabled": true
  }
}
